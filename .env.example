# Easiest: run `python -m app.doctor` (or setup.bat) — it writes this file for you.
# Copy this file to .env and fill in ONE LLM key.

# ---------- LLM used to plan + generate lessons ----------
# Options: gemini | groq | openai | anthropic | openrouter | ollama | mock
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# LLM_MODEL=gemini-2.5-flash        # optional override

# ---------- Automatic fallback ----------
# If the main model fails (overloaded 503, request too large 413, invalid JSON), the same request is
# retried on this model. Format provider:model
# FALLBACK_LLM=gemini:gemini-flash-latest

# ---------- Independent QC reviewer (recommended) ----------
# A DIFFERENT model for the two QC layers makes the review genuinely independent.
# Leave blank to reuse the generator model.
# QC_LLM_PROVIDER=groq
# QC_LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Other providers (only needed if you select them)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ---------- Research (all optional — free fallbacks need no key) ----------
# Web search: Tavily if set, otherwise DuckDuckGo (no key)
TAVILY_API_KEY=
# YouTube: Data API v3 if set (accurate durations/views), otherwise DuckDuckGo video search
YOUTUBE_API_KEY=
# live | mock  (mock = offline fixtures, for testing without internet)
RESEARCH_MODE=live

# chunked (default: outline, then sections in batches; robust on free tiers) | single (one big request)
GENERATION_MODE=chunked

# ---------- Lesson settings ----------
LESSON_MINUTES=45
READING_WPM=180
SPEAKING_WPM=130
CHECK_LINKS=true
